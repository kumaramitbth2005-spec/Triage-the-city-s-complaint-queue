# Server Environment Configuration
PORT=5000
NODE_ENV=production
APP_NAME=Nexus AI

# Database (MongoDB Atlas connection string)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/city_complaint_triage?retryWrites=true&w=majority

# Authentication Secret
JWT_SECRET=supersecretjwtkey_change_in_production_civic_app

# CORS / Frontend Domain (Add your Vercel/production deployment URLs)
FRONTEND_URL=https://triage-the-city-s-complaint-queue.vercel.app
CORS_ORIGIN=https://triage-the-city-s-complaint-queue.vercel.app,http://localhost:5173

# OTP Configuration
OTP_EXPIRY_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60

# ─── Option 1: Gmail SMTP / Any SMTP (RECOMMENDED - Sends to ANY email address) ───
# To send OTP to ANY email (Gmail, Yahoo, Outlook, etc.) without domain verification:
# 1. Enable 2-Step Verification in your Google Account: https://myaccount.google.com/security
# 2. Generate a 16-character App Password: https://myaccount.google.com/apppasswords
# 3. Paste your Gmail and App Password below:
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_char_gmail_app_password
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_FROM_NAME=Civic Complaint Triage

# ─── Option 2: Brevo Email REST API (Recommended for Cloud / Render Free Tier) ───
# Sends up to 300 emails/day to ANY email address over HTTPS (port 443, not blocked by Render)
BREVO_API_KEY=your_brevo_api_key
BREVO_SENDER_EMAIL=your_verified_sender_email@gmail.com

# ─── Option 3: Resend Email API ───
# Note: Resend free tier without a verified domain only delivers to your own registered email.
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=Civic Complaint Triage <onboarding@resend.dev>

# ─── Sandbox / Demo Fallback ───
# When true, automatically displays verification code on-screen if cloud email providers fail
ALLOW_SANDBOX_OTP=true

# Optional AI Services
AI_SERVICE_URL=http://localhost:8000
