# ==============================================================================
# Nexus AI - Environment Configuration Template
# ==============================================================================

# Server & Network
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# Database
MONGODB_URI=mongodb://localhost:27017/city_complaint_triage

# JSON Web Tokens
JWT_SECRET=your_jwt_secret_change_in_production
JWT_REFRESH_SECRET=your_jwt_refresh_secret_change_in_production

# ------------------------------------------------------------------------------
# Social Authentication Configuration
# ------------------------------------------------------------------------------

# Google OAuth 2.0 / OpenID Connect
# 1. Go to Google Cloud Console: https://console.cloud.google.com/apis/credentials
# 2. Create an OAuth 2.0 Client ID (Web Application)
# 3. Add Authorized JavaScript Origins: http://localhost:5173 (and production domain)
# 4. Add Authorized Redirect URIs: http://localhost:5173/login
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Facebook Login
# 1. Go to Meta for Developers: https://developers.facebook.com/apps/
# 2. Create an App with "Facebook Login" capability
# 3. Add Valid OAuth Redirect URIs: http://localhost:5173/login
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Frontend Vite OAuth Variables (for client-side button triggers)
# VITE_GOOGLE_CLIENT_ID=your_google_client_id_here
# VITE_FACEBOOK_APP_ID=your_facebook_app_id_here

# ------------------------------------------------------------------------------
# Email & OTP Dispatch Service
# ------------------------------------------------------------------------------
# Option A: Resend API (Recommended for Cloud Deployments)
RESEND_API_KEY=
EMAIL_FROM=Civic Complaint Triage <onboarding@resend.dev>

# Option B: Standard SMTP (Gmail, Brevo, SendGrid)
EMAIL_USER=
EMAIL_PASS=
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_FROM_NAME=Civic Complaint Triage

# Option C: Brevo API Key (Bypasses SMTP port restrictions on Render free tier)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
